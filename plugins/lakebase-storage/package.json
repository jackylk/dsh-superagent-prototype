{
  "name": "dsh-superagent-storage-lakebase",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": "^0.2.1-alpha.2"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test:isolation": "vitest run --config vitest.isolation.config.ts"
  },
  "peerDependencies": {
    "dsh-superagent": "^0.1.0",
    "@deepseek-ai/cordis": "4.0.5-alpha.1"
  },
  "dependencies": {
    "pg-native": "3.9.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "dsh-superagent": "workspace:*",
    "@deepseek-ai/cordis": "4.0.5-alpha.1",
    "@types/node": "22.20.0",
    "tsdown": "0.22.14",
    "typescript": "6.0.3",
    "vitest": "4.1.8"
  }
}
